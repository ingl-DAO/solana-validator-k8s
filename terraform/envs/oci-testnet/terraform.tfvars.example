# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

compartment_id      = "ocid1.tenancy.oc1..REPLACE"   # root compartment = your tenancy OCID
region              = "eu-frankfurt-1"
availability_domain = "REPLACE:EU-FRANKFURT-1-AD-1"  # oci iam availability-domain list

admin_cidr     = "203.0.113.4/32"                    # curl -4 -s ifconfig.me  (IPv4, not IPv6)
ssh_public_key = "ssh-ed25519 AAAA... you@host"

# 0 between build sessions. This one variable is ~$30 vs ~$245 over a 22-day trial.
node_pool_size = 1

budget_amount      = 250
budget_alert_email = ["you@example.com"]

# `oci session authenticate` issues a SECURITY TOKEN; the provider defaults to API-key auth and
# fails 401-NotAuthenticated without this. The profile is whatever name you typed at the prompt —
# case-sensitive, and often NOT DEFAULT. Check with: grep '^\[' ~/.oci/config
oci_auth           = "SecurityToken"
oci_config_profile = "DEFAULT"
